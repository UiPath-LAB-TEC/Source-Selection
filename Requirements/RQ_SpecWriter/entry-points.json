{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "/content/agent.json",
      "uniqueId": "d373ed5e-cc3d-467f-ad1b-77e7a7ab050c",
      "type": "agent",
      "input": {
        "type": "object",
        "properties": {
          "need": {
            "type": "string",
            "description": "The need in the program office's own words"
          },
          "context": {
            "type": "string",
            "description": "JSON: agency, requiring office, neededBy (yyyy-mm-dd or null), budget (dollars or null), kindHint"
          },
          "answers": {
            "type": "string",
            "description": "JSON array of {question, answer} from earlier rounds. An answer starting '(skipped' means the program office doesn't know yet"
          },
          "draft": {
            "type": "string",
            "description": "JSON: the structured requirement so far, as the program office last saved it"
          }
        },
        "required": [
          "need",
          "context",
          "answers",
          "draft"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Products: each item to buy",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Generic item name, never a brand"
                    },
                    "quantity": {
                      "type": "number",
                      "description": "How many"
                    },
                    "unit": {
                      "type": "string",
                      "description": "Unit of issue, e.g. each"
                    },
                    "characteristics": {
                      "type": "array",
                      "description": "Salient characteristics: what the item must do or meet, in performance terms, one per entry",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "quantity",
                    "unit",
                    "characteristics"
                  ]
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "standards": {
            "description": "Products: standards the items must meet, e.g. MIL-STD-810H",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "deliveryPlace": {
            "type": "string",
            "description": "Products: where to deliver"
          },
          "deliveryDate": {
            "type": "string",
            "description": "Products: when to deliver"
          },
          "warranty": {
            "type": "string",
            "description": "Products: warranty"
          },
          "packaging": {
            "type": "string",
            "description": "Products: packaging and marking"
          },
          "inspection": {
            "type": "string",
            "description": "Products: where and by whom inspection and acceptance happen"
          },
          "support": {
            "type": "string",
            "description": "Products: training and support"
          },
          "objective": {
            "type": "string",
            "description": "Services: the result the contractor must achieve"
          },
          "background": {
            "type": "string",
            "description": "Services: why the work is needed"
          },
          "scope": {
            "type": "string",
            "description": "Services: what the work covers"
          },
          "tasks": {
            "description": "Services: the tasks, stated as outcomes",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "deliverables": {
            "description": "Services: deliverables",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Deliverable"
                    },
                    "due": {
                      "type": "string",
                      "description": "When it is due"
                    },
                    "format": {
                      "type": "string",
                      "description": "Form, e.g. report"
                    }
                  },
                  "required": [
                    "name",
                    "due",
                    "format"
                  ]
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "performanceStandards": {
            "description": "Services: measurable standards",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "standard": {
                      "type": "string",
                      "description": "What is measured"
                    },
                    "aql": {
                      "type": "string",
                      "description": "Acceptable quality level"
                    },
                    "method": {
                      "type": "string",
                      "description": "How the government checks it"
                    }
                  },
                  "required": [
                    "standard",
                    "aql",
                    "method"
                  ]
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "placeOfPerformance": {
            "type": "string",
            "description": "Services: where"
          },
          "periodOfPerformance": {
            "type": "string",
            "description": "Services: how long"
          },
          "security": {
            "type": "string",
            "description": "Services: clearances, controlled information, base access"
          },
          "gfp": {
            "type": "string",
            "description": "Services: government-furnished property"
          },
          "keyPersonnel": {
            "type": "string",
            "description": "Services: key personnel, only if the program office named any"
          }
        },
        "required": []
      }
    }
  ]
}
