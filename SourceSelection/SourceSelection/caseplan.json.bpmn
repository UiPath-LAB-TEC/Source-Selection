      <uipath:caseManagement version="1.0"><![CDATA[{"root":{"id":"root","type":"case-management:root","version":"32.0.0","name":"SourceSelection","description":"Runs a FAR Part 15 best-value source selection for one solicitation, from proposal intake through individual evaluation, SSEB consensus, price evaluation and the Source Selection Authority's award decision. Agents draft findings and decision language with proposal-page citations; named officials make every judgment.","caseIdentifier":"=vars.solicitationId","caseIdentifierType":"external","caseAppEnabled":false,"publishVersion":2,"caseUnifiedSchemaEnabled":true,"data":{"workflowId":"case-Q7sLm2Xv9K","label":"SourceSelection","intsvcActivityConfig":"v2","uipath":{"bindings":[{"id":"bRb7Kq2Lm","name":"name","type":"string","resource":"process","resourceKey":"solution_folder.SS_Robots","default":"SS_Robots","propertyAttribute":"name"},{"id":"bRf3Np8Xc","name":"folderPath","type":"string","resource":"process","resourceKey":"solution_folder.SS_Robots","default":"","propertyAttribute":"folderPath"},{"id":"bCa4Wm9Ts","name":"name","type":"string","resource":"process","resourceSubType":"Agent","resourceKey":"solution_folder.SS_ConsensusAnalyst","default":"SS_ConsensusAnalyst","propertyAttribute":"name"},{"id":"bCf8Hq2Vd","name":"folderPath","type":"string","resource":"process","resourceSubType":"Agent","resourceKey":"solution_folder.SS_ConsensusAnalyst","default":"","propertyAttribute":"folderPath"},{"id":"bDw6Rk3Pn","name":"name","type":"string","resource":"process","resourceSubType":"Agent","resourceKey":"solution_folder.SS_DecisionWriter","default":"SS_DecisionWriter","propertyAttribute":"name"},{"id":"bDf2Lx7Gc","name":"folderPath","type":"string","resource":"process","resourceSubType":"Agent","resourceKey":"solution_folder.SS_DecisionWriter","default":"","propertyAttribute":"folderPath"},{"id":"bTf5Nv8Qe","name":"name","type":"string","resource":"app","resourceKey":"SourceSelection.Source Selection Task Forms",