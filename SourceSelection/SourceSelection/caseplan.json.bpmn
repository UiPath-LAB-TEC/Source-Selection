      <bpmn:task id="ClearSelectedStageVariableNode" name="Clear selected stage variable value">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_Activity_Guardrails-ClearSelectedStageVariableNode</bpmn:incoming>
        <bpmn:outgoing>edge_ClearSelectedStageVariableNode-GenerateUpdatedEventsNode</bpmn:outgoing>
      </bpmn:task>
      <bpmn:scriptTask id="GenerateUpdatedEventsNode" name="Generate updated events" scriptFormat="JavaScript">
        <bpmn:extensionElements>
          <uipath:skipObservability enabled="true" />
          <uipath:mapping version="v1">
            <uipath:type value="BPMN.Variables" version="v1" />
            <uipath:context>
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"vars":{"type":"object"},"metadata":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="args" type="json" target="bodyField"><![CDATA[{"vars":"=vars","metadata":"=metadata"}]]></uipath:input>
            <uipath:output name="scriptResponse" type="jsonSchema" source="=result.response" var="UpdatedEventsScriptResponse" />
            <uipath:output name="Error" type="jsonSchema" source="=result.response" var="UpdatedEventsScriptResponseError" />
          </uipath:mapping>
          <uipath:scriptVersion value="v3" />
        </bpmn:extensionElements>
        <bpmn:incoming>edge_ClearSelectedStageVariableNode-GenerateUpdatedEventsNode</bpmn:incoming>
        <bpmn:outgoing>edge_GenerateUpdatedEventsNode-EventSubProcessUpdateInstanceGlobalsNode</bpmn:outgoing>
        <bpmn:script><![CDATA[const rawDecisions = vars.caseManagerDecisions;
const rawStagesEntered = (rawDecisions != null && Array.isArray(rawDecisions.stagesEntered)) ? rawDecisions.stagesEntered : [];
const rawStagesExited = (rawDecisions != null && Array.isArray(rawDecisions.stagesExited)) ? rawDecisions.stagesExited : [];
const rawStagesCompleted = (rawDecisions != null && Array.isArray(rawDecisions.stagesCompleted)) ? rawDecisions.stagesCompleted : [];
// Null-prototype map so a hostile stageName like "__proto__" or "constructor" cannot mutate Object.prototype
// (prototype pollution) or corrupt the Object.values() iteration used to rebuild the winner arrays below.
const stageDecisionWinnerByName = Object.create(null);
const considerStageDecision = (kind, stage) => {
  if (stage == null || stage.stageName == null) return;
  const incomingIndex = (stage.index != null) ? stage.index : -1;
  const existing = stageDecisionWinnerByName[stage.stageName];
  if (existing == null || incomingIndex >= existing.index) {
    stageDecisionWinnerByName[stage.stageName] = { kind: kind, stage: stage, index: incomingIndex };
  }
};
rawStagesEntered.forEach((stage) => considerStageDecision("entered", stage));
rawStagesExited.forEach((stage) => considerStageDecision("exited", stage));
rawStagesCompleted.forEach((stage) => considerStageDecision("completed", stage));
const stageDecisionWinners = Object.values(stageDecisionWinnerByName);
const stagesEntered = stageDecisionWinners.filter((winner) => winner.kind === "entered").map((winner) => winner.stage);
const stagesExited = stageDecisionWinners.filter((winner) => winner.kind === "exited").map((winner) => winner.stage);
const stagesCompleted = stageDecisionWinners.filter((winner) => winner.kind === "completed").map((winner) => winner.stage);
const stagesEnteredByKey = stagesEntered.reduce((acc, stage) => {
acc[`CM:stagesEntered:${stage.stageName}`] = true;
return acc;
}, {});
const stagesExitedByKey = stagesExited.reduce((acc, stage) => {
acc[`CM:stagesExited:${stage.stageName}`] = true;
return acc;
}, {});
const stagesCompletedByKey = stagesCompleted.reduce((acc, stage) => {
acc[`CM:stagesCompleted:${stage.stageName}`] = true;
return acc;
}, {});
const allEventsUpdatedKeys = { ...stagesEnteredByKey, ...stagesExitedByKey, ...stagesCompletedByKey };
const lastPrimaryStageExited = [...stagesCompleted.map((stage) => stage.stageName), ...stagesExited.map((stage) => stage.stageName)];
if (lastPrimaryStageExited?.length) {
allEventsUpdatedKeys["CaseGlobalsLastPrimaryStageExited"] = lastPrimaryStageExited;
}

const exitedStageKeysToDelete = stagesEntered.map((stage) => `CM:stagesExited:${stage.stageName}`);
const completedStageKeysToDelete = stagesEntered.map((stage) => `CM:stagesCompleted:${stage.stageName}`);
const enteredStageKeysToDeleteForExits = stagesExited.map((stage) => `CM:stagesEntered:${stage.stageName}`);
const enteredStageKeysToDeleteForCompletes = stagesCompleted.map((stage) => `CM:stagesEntered:${stage.stageName}`);
const sequentialTasksToResetByStageName = Object.create(null);
for (const [stageName, taskNames] of [["Consensus",["Compile Individual Evaluations","Draft Consensus","SSEB Chair Consensus"]]]) {
sequentialTasksToResetByStageName[stageName] = taskNames;
}
const tasksCompletedDeleteNames = stagesEntered.flatMap((stage) => (sequentialTasksToResetByStageName[stage.stageName] || []));
return { upsertKeys: allEventsUpdatedKeys, deleteKeys: [...exitedStageKeysToDelete, ...completedStageKeysToDelete, ...enteredStageKeysToDeleteForExits, ...enteredStageKeysToDeleteForCompletes], tasksCompletedDeleteNames };]]></bpmn:script>
      </bpmn:scriptTask>
