            <uipath:context>
              <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"upsertKeys":{"type":"object"},"deleteKeys":{"type":"object"},"tasksCompletedDeleteNames":{"type":"object"}},"required":[]}]]></uipath:inputSchema>
            </uipath:context>
            <uipath:input name="ItemData" type="json" target="body"><![CDATA[{"upsertKeys":"=js:({ ...(vars.UpdatedEventsScriptResponse?.upsertKeys ?? {}) })","deleteKeys":"=js:([ ...(vars.UpdatedEventsScriptResponse?.deleteKeys ?? []) ])","tasksCompletedDeleteNames":"=js:([ ...(vars.UpdatedEventsScriptResponse?.tasksCompletedDeleteNames ?? []) ])"}]]></uipath:input>
          </uipath:activity>
        </bpmn:extensionElements>
