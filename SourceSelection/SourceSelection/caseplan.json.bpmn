) }, \"APIEvent\": (vars.mainEventSubprocessResponse.apiEvent), \"businessEventType\": (vars.mainEventSubprocessResponse.businessEventType), \"metadata\": { \"FolderKey\": (metadata.FolderKey), \"ProcessKey\": (metadata.ProcessKey), \"InstanceId\": (metadata.InstanceId), \"ExternalId\": (metadata.ExternalId) }, \"stageSla_Individual_Evaluation_sla_Ie4Tq8Wm\": { \"slaStatus\": (vars.stageSla_Individual_Evaluation_sla_Ie4Tq8Wm?.slaStatus), \"Individual_Evaluation_SLA_at_risk\": { \"startTimeEpoch\": (vars.stageSla_Individual_Evaluation_sla_Ie4Tq8Wm?.Individual_Evaluation_SLA_at_risk?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Individual_Evaluation_sla_Ie4Tq8Wm?.Individual_Evaluation_SLA_at_risk?.endTimeEpoch) }, \"Individual_Evaluation_SLA_breached\": { \"startTimeEpoch\": (vars.stageSla_Individual_Evaluation_sla_Ie4Tq8Wm?.Individual_Evaluation_SLA_breached?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Individual_Evaluation_sla_Ie4Tq8Wm?.Individual_Evaluation_SLA_breached?.endTimeEpoch) } }, \"stageSla_Consensus_sla_Cn6Hv2Xp\": { \"slaStatus\": (vars.stageSla_Consensus_sla_Cn6Hv2Xp?.slaStatus), \"Consensus_SLA_at_risk\": { \"startTimeEpoch\": (vars.stageSla_Consensus_sla_Cn6Hv2Xp?.Consensus_SLA_at_risk?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Consensus_sla_Cn6Hv2Xp?.Consensus_SLA_at_risk?.endTimeEpoch) }, \"Consensus_SLA_breached\": { \"startTimeEpoch\": (vars.stageSla_Consensus_sla_Cn6Hv2Xp?.Consensus_SLA_breached?.startTimeEpoch), \"endTimeEpoch\": (vars.stageSla_Consensus_sla_Cn6Hv2Xp?.Consensus_SLA_breached?.endTimeEpoch) } } } } })"}]]></uipath:input>
